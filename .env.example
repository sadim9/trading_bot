# ─────────────────────────────────────────────────────────────
#  Trading Bot — Environment Variables
#  Copy this file to .env and fill in ALL values before running.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
APP_NAME=TradingBot API
APP_VERSION=1.0.0
ENVIRONMENT=production          # development | production
DEBUG=false

# ── Security ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_STRING

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Trusted Hosts ──────────────────────────────────────────
# Comma-separated. Must include your domain in production.
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=trading
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=trading_bot
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://trading:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/trading_bot

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# ── Bot Worker ────────────────────────────────────────────────
BOT_POLL_INTERVAL_SECONDS=60
BOT_DEFAULT_SOURCE=yfinance
# Set to admin user UUID after first registration
BOT_WORKER_USER_ID=
# Strategy mode: multi | markov | markov_multi
# markov_multi = Markov Chains 40% + classic strategies 60% (recommended for testing)
BOT_STRATEGY_MODE=markov_multi
# Auto-create paper trades from strong signals (true | false)
BOT_AUTO_PAPER_TRADE=false

# ── Twelve Data (optional — for commodity price feeds) ────────
TWELVEDATA_API_KEY=

# ── Discord (optional) ────────────────────────────────────────
DISCORD_BOT_TOKEN=
D