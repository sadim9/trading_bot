//@version=6
// ============================================================================
//  UNIVERSAL REGIME-AWARE STRATEGY  v14
//  Works on Stocks · Crypto · Forex · Commodities — M5 optimised
//  Pine Script v6
//
//  CORE ENTRY RULES (what the strategy actually enforces):
//
//  BUY signal requires ALL of:
//    1. EMA stack: EMA20 > EMA50 > EMA200 (uptrend alignment)
//    2. Price above EMA20 (not in a pullback below structure)
//    3. SuperTrend (5m) is bullish AND just flipped bull
//    4. 15m SuperTrend is also bullish (HTF agreement)
//    5. ADX >= 20 (trend has conviction, not ranging)
//    6. DI+ > DI- (buyers in control)
//    7. RSI between 40-75 (momentum but not overbought)
//    8. Momentum candle: current bar closes bullish and body >= 40% of range
//    9. Not in cooldown after loss
//
//  SELL signal requires ALL of:
//    1. EMA stack: EMA20 < EMA50 < EMA200 (downtrend alignment)
//    2. Price below EMA20 (not in a bounce above structure)
//    3. SuperTrend (5m) is bearish AND just flipped bear
//    4. 15m SuperTrend is also bearish (HTF agreement)
//    5. ADX >= 20 (trend has conviction, not ranging)
//    6. DI- > DI+ (sellers in control)
//    7. RSI between 25-60 (momentum but not oversold)
//    8. Momentum candle: current bar closes bearish and body >= 40% of range
//    9. Not in cooldown after loss
//
//  EXIT rules:
//    - Fixed stop loss: below EMA20 - 1.5×ATR (long) / above EMA20 + 1.5×ATR (short)
//    - Take profit: 2.5R fixed OR SuperTrend flips against position (whichever first)
//    - If price crosses back through EMA20 against position, close immediately
// ============================================================================

strategy(
    title                   = "Universal Regime-Aware Strategy",
    shorttitle              = "URA-STRAT",
    overlay                 = true,
    default_qty_type        = strategy.percent_of_equity,
    default_qty_value       = 1,
    initial_capital         = 10000,
    currency                = currency.USD,
    commission_type         = strategy.commission.percent,
    commission_value        = 0.07,
    slippage                = 2,
    process_orders_on_close = false,
    calc_on_every_tick      = false,
    max_boxes_count         = 500,
    max_lines_count         = 500,
    max_labels_count        = 500
)

// ============================================================================
// SECTION 1 — SUPERTREND SETTINGS
// ============================================================================

grpST = "SUPERTREND"
stPeriod  = input.int(10,   "SuperTrend Period (5m)",         group=grpST, minval=3)
stMult    = input.float(2.0,"SuperTrend Multiplier (5m)",     group=grpST, step=0.1, minval=0.5,
    tooltip="Lower = more sensitive, more flips. Higher = fewer, cleaner flips. Gold: 2.5–3.5. Stocks: 1.5–2.5.")
stPeriodH = input.int(10,   "SuperTrend Period (15m HTF)",    group=grpST, minval=3)
stMultH   = input.float(2.0,"SuperTrend Multiplier (15m HTF)",group=grpST, step=0.1, minval=0.5)
useHtfGate = input.bool(true, "Require 15m ST agreement",     group=grpST,
    tooltip="ON (recommended): BUY only when 15m ST is also bull. SELL only when 15m ST is also bear.")

// ============================================================================
// SECTION 2 — EMA SETTINGS
// ============================================================================

grpE = "EMA SETTINGS"
ema20Len  = input.int(20,  "EMA 20 (fast trend)",  group=grpE, minval=5)
ema50Len  = input.int(50,  "EMA 50 (mid trend)",   group=grpE, minval=10)
ema200Len = input.int(200, "EMA 200 (macro trend)", group=grpE, minval=50)
emaStrict = input.bool(true, "Strict EMA stack (20>50>200 for longs, 20<50<200 for shorts)", group=grpE,
    tooltip="ON (recommended): all 3 EMAs must be aligned. OFF: only EMA20 vs EMA50 required.")

// ============================================================================
// SECTION 3 — ADX / MOMENTUM SETTINGS
// ============================================================================

grpA = "ADX / MOMENTUM"
adxLen     = input.int(14, "ADX Period",                    group=grpA, minval=5)
adxMin     = input.int(20, "Min ADX to enter trade",        group=grpA, minval=10,
    tooltip="Signal blocked if ADX < this. 20 = decent trend. Raise to 25 for Gold to avoid choppy entries.")
bodyPct    = input.float(40.0, "Min candle body % of range", group=grpA, step=5.0, minval=10.0,
    tooltip="Entry bar body must be at least this % of high-low range. Filters weak indecision candles.")

// ============================================================================
// SECTION 4 — RSI SETTINGS
// ============================================================================

grpRSI = "RSI FILTER"
rsiLen      = input.int(14, "RSI Period",                    group=grpRSI, minval=2)
rsiLongMin  = input.int(40, "Long: min RSI (momentum floor)",group=grpRSI, minval=20, maxval=55,
    tooltip="RSI must be above this for a BUY. 40 = price has momentum. Below 40 = weak/reversal, skip.")
rsiLongMax  = input.int(75, "Long: max RSI (overbought cap)", group=grpRSI, minval=60, maxval=90,
    tooltip="RSI must be below this for a BUY. Above 75 = overbought, chasing.")
rsiShortMin = input.int(25, "Short: min RSI (oversold cap)",  group=grpRSI, minval=10, maxval=40,
    tooltip="RSI must be above this for a SELL. Below 25 = already oversold, skip.")
rsiShortMax = input.int(60, "Short: max RSI (momentum ceil)", group=grpRSI, minval=45, maxval=80,
    tooltip="RSI must be below this for a SELL. 60 = price has downward momentum.")

// ============================================================================
// SECTION 5 — STOP LOSS & TAKE PROFIT
// ============================================================================

grpSL = "STOP LOSS & TAKE PROFIT"
slAtrMult = input.float(1.5, "SL distance = EMA20 ± (ATR × this)", group=grpSL, step=0.1, minval=0.3)
rrRatio   = input.float(2.5, "Risk:Reward Ratio (fixed TP)",        group=grpSL, step=0.1, minval=0.5)
useStTrail = input.bool(true, "Also exit on ST flip (trail exit)",  group=grpSL,
    tooltip="If ST flips against your position before TP is hit, close immediately.")
useEmaExit = input.bool(true, "Also exit if price crosses EMA20",   group=grpSL,
    tooltip="If price closes back through EMA20 against your trade, exit. Prevents giving back profits.")

// ============================================================================
// SECTION 6 — POSITION SIZING
// ============================================================================

grpQ = "POSITION SIZING"
posMode       = input.string("risk_percent", "Mode", options=["risk_percent","fixed_qty"], group=grpQ)
riskPct       = input.float(1.0, "Risk % of equity per trade", group=grpQ, minval=0.1, step=0.1)
fixedQty      = input.float(1.0, "Fixed qty (if mode = fixed_qty)", group=grpQ, minval=0.000001)
contractValue = input.float(1.0, "Contract value (Stock/Crypto=1, Gold=100, FX=100000)", group=grpQ, minval=0.000001)

// ============================================================================
// SECTION 7 — TRADE MANAGEMENT
// ============================================================================

grpM = "TRADE MANAGEMENT"
maxDailyTrades = input.int(5,  "Max trades per day",               group=grpM, minval=1)
maxConcurrent  = input.int(1,  "Max concurrent open trades",       group=grpM, minval=1)
cooldownBars   = input.int(2,  "Min bars between trades",          group=grpM, minval=0)
lossCooldown   = input.int(5,  "Extra bars cooldown after SL hit", group=grpM, minval=0,
    tooltip="Wait this many extra bars after a stop-loss before next entry. Prevents cascade losses.")

// ============================================================================
// SECTION 8 — SESSION FILTER
// ============================================================================

grpS = "SESSION FILTER"
enableSessionFilter = input.bool(false, "Enable Session Filter",       group=grpS)
sessionStr          = input.session("0800-2000", "Allowed session",    group=grpS,
    tooltip="Only trade within this time window (exchange timezone). e.g. 0800-2000 for London+NY overlap.")

// ============================================================================
// SECTION 9 — DISPLAY
// ============================================================================

grpD = "DISPLAY"
showEmas        = input.bool(true,  "Show EMAs",                    group=grpD)
showST          = input.bool(true,  "Show SuperTrend",              group=grpD)
showRegimeBg    = input.bool(true,  "Show trend background colour", group=grpD)
showSlTpLines   = input.bool(true,  "Show SL / TP lines",           group=grpD)
showTradeLabels = input.bool(true,  "Show per-trade P&L labels",    group=grpD)
showStatusTable = input.bool(true,  "Show Status table",            group=grpD)
showTradeLog    = input.bool(true,  "Show trade log (last 10)",     group=grpD)

// ============================================================================
// SECTION 10 — CORE CALCULATIONS
// ============================================================================

ema20  = ta.ema(close, ema20Len)
ema50  = ta.ema(close, ema50Len)
ema200 = ta.ema(close, ema200Len)
rsi    = ta.rsi(close, rsiLen)
atrVal = ta.atr(14)

// ── 5m SuperTrend ──────────────────────────────────────────────────────────
calcST(period, mult) =>
    a   = ta.atr(period)
    up  = hl2 + mult * a
    dn  = hl2 - mult * a
    var float stUp  = na
    var float stDn  = na
    var int   stDir = 1
    stUp  := na(stUp[1])  ? up : (up < stUp[1]  or close[1] > stUp[1]  ? up  : stUp[1])
    stDn  := na(stDn[1])  ? dn : (dn > stDn[1]  or close[1] < stDn[1]  ? dn  : stDn[1])
    stDir := stDir[1] == -1 ? (close > stUp[1] ? 1 : -1) : (close < stDn[1] ? -1 : 1)
    [stUp, stDn, stDir]

[stUpper, stLower, stDir] = calcST(stPeriod, stMult)
stLine     = stDir == 1 ? stLower : stUpper
stFlipBull = stDir == 1  and stDir[1] == -1
stFlipBear = stDir == -1 and stDir[1] == 1

// ── 15m SuperTrend (HTF gate — computed inside request.security) ──────────
calcHTFST(period, mult) =>
    a_  = ta.atr(period)
    up_ = hl2 + mult * a_
    dn_ = hl2 - mult * a_
    var float su_ = na
    var float sd_ = na
    var int   sd  = 1
    su_ := na(su_[1]) ? up_ : (up_ < su_[1] or close[1] > su_[1] ? up_ : su_[1])
    sd_ := na(sd_[1]) ? dn_ : (dn_ > sd_[1] or close[1] < sd_[1] ? dn_ : sd_[1])
    sd  := sd[1] == -1 ? (close > su_[1] ? 1 : -1) : (close < sd_[1] ? -1 : 1)
    sd

htfStDirection = request.security(syminfo.tickerid, "15", calcHTFST(stPeriodH, stMultH), lookahead=barmerge.lookahead_off)
htfBull = htfStDirection == 1
htfBear = htfStDirection == -1

// ── ADX / DMI ──────────────────────────────────────────────────────────────
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

// ── EMA alignment ─────────────────────────────────────────────────────────
// Uptrend: EMA20 > EMA50 > EMA200 AND price above EMA20
// Downtrend: EMA20 < EMA50 < EMA200 AND price below EMA20
emaUptrendStrict   = ema20 > ema50 and ema50 > ema200
emaDowntrendStrict = ema20 < ema50 and ema50 < ema200
emaUptrendSoft     = ema20 > ema50
emaDowntrendSoft   = ema20 < ema50

emaUptrend   = emaStrict ? emaUptrendStrict   : emaUptrendSoft
emaDowntrend = emaStrict ? emaDowntrendStrict : emaDowntrendSoft

priceAboveEma20 = close > ema20
priceBelowEma20 = close < ema20

// ── EMA slope (rising / falling) ─────────────────────────────────────────
ema20Rising  = ema20 > ema20[3]
ema20Falling = ema20 < ema20[3]
ema50Rising  = ema50 > ema50[3]
ema50Falling = ema50 < ema50[3]

// ── Candle body filter ────────────────────────────────────────────────────
candleRange  = high - low
bodySize     = math.abs(close - open)
bodyRatioPct = candleRange > 0 ? (bodySize / candleRange) * 100 : 0.0
bullCandle   = close > open and bodyRatioPct >= bodyPct   // strong green close
bearCandle   = close < open and bodyRatioPct >= bodyPct   // strong red close

// ── Regime background colour ──────────────────────────────────────────────
trendBgCol = emaUptrendStrict   ? color.new(#00E676, 96) :
             emaDowntrendStrict ? color.new(#FF5252, 96) :
             emaUptrendSoft     ? color.new(#00E676, 98) :
             emaDowntrendSoft   ? color.new(#FF5252, 98) : color.new(#787B86, 98)

bgcolor(showRegimeBg ? trendBgCol : na, title="Trend Background")

// Export a regime code for the companion indicator
regimeCode = emaUptrendStrict ? 1 : emaDowntrendStrict ? 2 : emaUptrendSoft ? 5 : emaDowntrendSoft ? 6 : 7
plot(regimeCode, "Regime Code (sync)", display=display.none)

// ============================================================================
// SECTION 11 — SESSION FILTER
// ============================================================================

inSession = enableSessionFilter ? not na(time(timeframe.period, sessionStr)) : true

// ============================================================================
// SECTION 12 — COOLDOWN COUNTERS
// ============================================================================

// General cooldown
var int barsSinceExit = cooldownBars
if strategy.position_size[1] != 0 and strategy.position_size == 0
    barsSinceExit := 0
else if strategy.position_size == 0
    barsSinceExit := math.min(barsSinceExit + 1, 999)
cooldownOk = barsSinceExit >= cooldownBars

// Post-loss cooldown
var int barsSinceLoss = lossCooldown
var int prevClosedTrades = 0
if strategy.closedtrades > prevClosedTrades
    lastIdx = strategy.closedtrades - 1
    if strategy.closedtrades.profit(lastIdx) < 0
        barsSinceLoss := 0
    prevClosedTrades := strategy.closedtrades
if strategy.position_size == 0
    barsSinceLoss := math.min(barsSinceLoss + 1, 999)
lossCooldownOk = barsSinceLoss >= lossCooldown

// ============================================================================
// SECTION 13 — DAILY TRADE COUNTER
// ============================================================================

var int dailyCount = 0
var int lastDay    = na
currDay = dayofmonth + month * 100 + year * 10000
if na(lastDay) or currDay != lastDay
    dailyCount := 0
    lastDay    := currDay
withinDailyLimit = dailyCount < maxDailyTrades

// ============================================================================
// SECTION 14 — ENTRY CONDITIONS
// ============================================================================

adxOk        = adx >= adxMin
diLongOk     = diPlus > diMinus     // buyers dominating
diShortOk    = diMinus > diPlus     // sellers dominating
rsiLongOk    = rsi >= rsiLongMin and rsi <= rsiLongMax    // RSI 40-75
rsiShortOk   = rsi >= rsiShortMin  and rsi <= rsiShortMax  // RSI 25-60
htfGateLong  = not useHtfGate or htfBull
htfGateShort = not useHtfGate or htfBear
noOpenTrade  = strategy.opentrades < maxConcurrent

// ── BUY: all conditions must align ─────────────────────────────────────────
longCond = stFlipBull           // 5m ST just flipped bullish (trigger)
         and emaUptrend         // EMAs aligned upward (20>50>200)
         and priceAboveEma20    // price is above EMA20 (not in pullback)
         and ema20Rising        // EMA20 itself is pointing up
         and htfGateLong        // 15m ST agrees = bull
         and adxOk              // ADX >= 20, trend has strength
         and diLongOk           // DI+ > DI-, buyers dominating
         and rsiLongOk          // RSI 40-75, momentum not overbought
         and bullCandle         // strong green close on flip bar
         and inSession
         and cooldownOk
         and lossCooldownOk
         and withinDailyLimit
         and noOpenTrade

// ── SELL: all conditions must align ────────────────────────────────────────
shortCond = stFlipBear          // 5m ST just flipped bearish (trigger)
          and emaDowntrend      // EMAs aligned downward (20<50<200)
          and priceBelowEma20   // price is below EMA20 (not in bounce)
          and ema20Falling      // EMA20 itself is pointing down
          and htfGateShort      // 15m ST agrees = bear
          and adxOk             // ADX >= 20
          and diShortOk         // DI- > DI+, sellers dominating
          and rsiShortOk        // RSI 25-60, momentum not oversold
          and bearCandle        // strong red close on flip bar
          and inSession
          and cooldownOk
          and lossCooldownOk
          and withinDailyLimit
          and noOpenTrade

// ============================================================================
// SECTION 15 — SL / TP CALCULATION
// ============================================================================

calcSL(isLong, ep) =>
    raw = isLong ? ema20 - atrVal * slAtrMult : ema20 + atrVal * slAtrMult
    // Ensure minimum distance of 0.5 ATR
    isLong ? math.min(raw, ep - atrVal * 0.5) : math.max(raw, ep + atrVal * 0.5)

calcTP(isLong, ep, sl) =>
    risk = math.abs(ep - sl)
    isLong ? ep + risk * rrRatio : ep - risk * rrRatio

calcQty(ep, sl) =>
    risk    = math.abs(ep - sl)
    riskAmt = strategy.equity * riskPct / 100.0
    qty     = posMode == "risk_percent" ? (risk > 0 and contractValue > 0 ? riskAmt / (risk * contractValue) : fixedQty) : fixedQty
    math.max(qty, 0.000001)

// ============================================================================
// SECTION 16 — TRADE EXECUTION
// ============================================================================

var float entryPx = na
var float slPx    = na
var float tpPx    = na

if longCond
    ep_  = close
    sl_  = calcSL(true, ep_)
    tp_  = calcTP(true, ep_, sl_)
    qty_ = calcQty(ep_, sl_)
    entryPx := ep_
    slPx    := sl_
    tpPx    := tp_
    strategy.entry("Long", strategy.long, qty=qty_,
        comment="L|RSI:" + str.tostring(rsi,"#.0") + "|ADX:" + str.tostring(adx,"#.0"))
    strategy.exit("Long X", from_entry="Long", stop=sl_, limit=tp_,
        comment_loss="SL", comment_profit="TP")
    dailyCount += 1

if shortCond
    ep_  = close
    sl_  = calcSL(false, ep_)
    tp_  = calcTP(false, ep_, sl_)
    qty_ = calcQty(ep_, sl_)
    entryPx := ep_
    slPx    := sl_
    tpPx    := tp_
    strategy.entry("Short", strategy.short, qty=qty_,
        comment="S|RSI:" + str.tostring(rsi,"#.0") + "|ADX:" + str.tostring(adx,"#.0"))
    strategy.exit("Short X", from_entry="Short", stop=sl_, limit=tp_,
        comment_loss="SL", comment_profit="TP")
    dailyCount += 1

// ── Trail exits ─────────────────────────────────────────────────────────────
if strategy.position_size > 0
    // Exit long if ST flips bear
    if useStTrail and stFlipBear
        strategy.close("Long", comment="ST Trail")
    // Exit long if price closes back below EMA20
    if useEmaExit and close < ema20
        strategy.close("Long", comment="EMA20 Exit")

if strategy.position_size < 0
    // Exit short if ST flips bull
    if useStTrail and stFlipBull
        strategy.close("Short", comment="ST Trail")
    // Exit short if price closes back above EMA20
    if useEmaExit and close > ema20
        strategy.close("Short", comment="EMA20 Exit")

// ============================================================================
// SECTION 17 — SL / TP LINES
// ============================================================================

var line slLine = na
var line tpLine = na

if showSlTpLines
    if longCond or shortCond
        line.delete(slLine)
        line.delete(tpLine)
        slLine := line.new(bar_index, slPx, bar_index + 80, slPx,
                           color=color.new(#FF5252,0), width=1, style=line.style_dashed)
        tpLine := line.new(bar_index, tpPx, bar_index + 80, tpPx,
                           color=color.new(#00E676,0), width=1, style=line.style_dashed)
    if strategy.position_size == 0 and strategy.position_size[1] != 0
        line.delete(slLine)
        line.delete(tpLine)

// ============================================================================
// SECTION 18 — PER-TRADE P&L LABELS
// ============================================================================

if showTradeLabels and strategy.closedtrades > strategy.closedtrades[1]
    i_  = strategy.closedtrades - 1
    pnl = strategy.closedtrades.profit(i_)
    isW = pnl > 0
    label.new(bar_index, isW ? high * 1.001 : low * 0.999,
              text  = (isW ? "✓ +" : "✗ ") + str.tostring(pnl,"#.##"),
              style = isW ? label.style_label_down : label.style_label_up,
              color = isW ? color.new(#00E676,10) : color.new(#FF5252,10),
              textcolor=color.white, size=size.small)

// ============================================================================
// SECTION 19 — PLOTS
// ============================================================================

plot(showEmas ? ema200 : na, "EMA 200", color=color.new(#2196F3,0), linewidth=2)
plot(showEmas ? ema50  : na, "EMA 50",  color=color.new(#F7931A,0), linewidth=1)
plot(showEmas ? ema20  : na, "EMA 20",  color=color.new(#26C6DA,0), linewidth=1)

stPlotCol = stDir == 1 ? color.new(#00E676,40) : color.new(#FF5252,40)
plot(showST ? stLine : na, "SuperTrend", color=stPlotCol, linewidth=2)

plotshape(longCond,  "BUY",  shape.triangleup,   location.belowbar, color.new(#00E676,0), size=size.normal, text="BUY")
plotshape(shortCond, "SELL", shape.triangledown,  location.abovebar, color.new(#FF5252,0), size=size.normal, text="SELL")

// ============================================================================
// SECTION 20 — COMBINED STATUS + METRICS TABLE
// ============================================================================

var table combinedT = table.new(position.top_right, 4, 18,
    bgcolor=color.new(#131722,10), border_color=color.new(#2A2E39,0), border_width=1,
    frame_color=color.new(#2A2E39,0), frame_width=1)

if barstate.islast
    ct     = strategy.closedtrades
    wt     = 0
    lt     = 0
    grossW = 0.0
    grossL = 0.0
    for i = 0 to math.max(ct - 1, 0)
        p = strategy.closedtrades.profit(i)
        if p > 0
            wt     += 1
            grossW += p
        else
            lt     += 1
            grossL += math.abs(p)
    wr   = ct > 0 ? wt / ct * 100 : 0.0
    pf   = grossL > 0 ? grossW / grossL : na
    avgW = wt > 0 ? grossW / wt : 0.0
    avgL = lt > 0 ? grossL / lt : 0.0
    exp_ = ct > 0 ? strategy.netprofit / ct : 0.0
    wrC  = wr >= 50 ? #00E676 : wr >= 40 ? #FFC107 : #FF5252
    pfC  = not na(pf) and pf >= 1.5 ? #00E676 : not na(pf) and pf >= 1.0 ? #FFC107 : #FF5252
    sz   = size.tiny

    // ── STATUS panel (cols 0-1) ───────────────────────────────────────────
    if showStatusTable
        table.cell(combinedT, 0, 0,  "STATUS",   text_color=#D1D4DC, bgcolor=#1A3A5C, text_size=size.small)
        table.cell(combinedT, 1, 0,  "v14",      text_color=#FFC107, bgcolor=#1A3A5C, text_size=size.small)
        table.cell(combinedT, 0, 1,  "EMA Stack",text_color=#787B86, bgcolor=#1E222D, text_size=sz)
        table.cell(combinedT, 1, 1,  emaUptrendStrict?"▲ BULL":emaDowntrendStrict?"▼ BEAR":emaUptrend?"↗ soft bull":emaDowntrend?"↘ soft bear":"⟷ MIXED", text_color=emaUptrend?#00E676:emaDowntrend?#FF5252:#FFC107, bgcolor=#131722, text_size=sz)
        table.cell(combinedT, 0, 2,  "5m ST",    text_color=#787B86, bgcolor=#1E222D, text_size=sz)
        table.cell(combinedT, 1, 2,  stDir==1?"BULL":"BEAR", text_color=stDir==1?#00E676:#FF5252, bgcolor=#131722, text_size=sz)
        table.cell(combinedT, 0, 3,  "5m Flip",  text_color=#787B86, bgcolor=#1E222D, text_size=sz)
        table.cell(combinedT, 1, 3,  stFlipBull?"▲ BULL":stFlipBear?"▼ BEAR":"–", text_color=stFlipBull?#00E676:stFlipBear?#FF5252:#787B86, bgcolor=#131722, text_size=sz)
        table.cell(combinedT, 0, 4,  "15m ST",   text_color=#787B86, bgcolor=#1E222D, text_size=sz)
        table.cell(combinedT, 1, 4,  htfBull?"BULL":"BEAR", text_color=htfBull?#00E676:#FF5252, bgcolor=#131722, text_size=sz)
        table.cell(combinedT, 0, 5,  "ADX",      text_color=#787B86, bgcolor=#1E222D, text_size=sz)
        table.cell(combinedT, 1, 5,  str.tostring(adx,"#.0")+(adxOk?" ✓":" ✗"), text_color=adxOk?#00E676:#FF5252, bgcolor=#131722, text_size=sz)
        table.cell(combinedT, 0, 6,  "DI+/DI-",  text_color=#787B86, bgcolor=#1E222D, text_size=sz)
        table.cell(combinedT, 1, 6,  str.tostring(diPlus,"#.0")+"/"+str.tostring(diMinus,"#.0"), text_color=diPlus>diMinus?#00E676:#FF5252, bgcolor=#131722, text_size=sz)
        table.cell(combinedT, 0, 7,  "RSI",      text_color=#787B86, bgcolor=#1E222D, text_size=sz)
        table.cell(combinedT, 1, 7,  str.tostring(rsi,"#.0")+(rsiLongOk?" L✓":rsiShortOk?" S✓":" ✗"), text_color=rsi>70?#FF5252:rsi<30?#00E676:#D1D4DC, bgcolor=#131722, text_size=sz)
        table.cell(combinedT, 0, 8,  "Candle",   text_color=#787B86, bgcolor=#1E222D, text_size=sz)
        table.cell(combinedT, 1, 8,  bullCandle?"▲ Bull":bearCandle?"▼ Bear":"weak", text_color=bullCandle?#00E676:bearCandle?#FF5252:#FFC107, bgcolor=#131722, text_size=sz)
        table.cell(combinedT, 0, 9,  "Px>EMA20", text_color=#787B86, bgcolor=#1E222D, text_size=sz)
        table.cell(combinedT, 1, 9,  priceAboveEma20?"YES":"NO", text_color=priceAboveEma20?#00E676:#FF5252, bgcolor=#131722, text_size=sz)
        table.cell(combinedT, 0, 10, "HTF Gate", text_color=#787B86, bgcolor=#1E222D, text_size=sz)
        table.cell(combinedT, 1, 10, htfGateLong?"L-OK":htfGateShort?"S-OK":"BLOCK", text_color=(htfGateLong or htfGateShort)?#00E676:#FF5252, bgcolor=#131722, text_size=sz)
        table.cell(combinedT, 0, 11, "Cooldown", text_color=#787B86, bgcolor=#1E222D, text_size=sz)
        table.cell(combinedT, 1, 11, cooldownOk and lossCooldownOk?"OK":"WAIT", text_color=cooldownOk and lossCooldownOk?#00E676:#FFC107, bgcolor=#131722, text_size=sz)
        table.cell(combinedT, 0, 12, "Signal",   text_color=#787B86, bgcolor=#1E222D, text_size=sz)
        table.cell(combinedT, 1, 12, longCond?"▲ BUY":shortCond?"▼ SELL":"–", text_color=longCond?#00E676:shortCond?#FF5252:#787B86, bgcolor=longCond?color.new(#00E676,80):shortCond?color.new(#FF5252,80):#131722, text_size=sz)
        table.cell(combinedT, 0, 13, "Trades/d", text_color=#787B86, bgcolor=#1E222D, text_size=sz)
        table.cell(combinedT, 1, 13, str.tostring(dailyCount)+"/"+str.tostring(maxDailyTrades), text_color=dailyCount>=maxDailyTrades?#FF5252:#FFC107, bgcolor=#131722, text_size=sz)

    // ── URA METRICS panel (cols 2-3) ──────────────────────────────────────
    table.cell(combinedT, 2, 0,  "URA STRATEGY",  text_color=#D1D4DC, bgcolor=#2A2E39, text_size=size.small)
    table.cell(combinedT, 3, 0,  strategy.position_size>0?"▲ LONG":strategy.position_size<0?"▼ SHORT":"◆ FLAT",
               text_color=strategy.position_size>0?#00E676:strategy.position_size<0?#FF5252:#787B86, bgcolor=#2A2E39, text_size=size.small)
    table.cell(combinedT, 2, 1,  "Closed Trades", text_color=#787B86, bgcolor=#1E222D, text_size=sz)
    table.cell(combinedT, 3, 1,  str.tostring(ct),                           text_color=#D1D4DC, bgcolor=#131722, text_size=sz)
    table.cell(combinedT, 2, 2,  "Win Rate",      text_color=#787B86, bgcolor=#1E222D, text_size=sz)
    table.cell(combinedT, 3, 2,  str.tostring(wr,"#.1")+"%",                 text_color=wrC,    bgcolor=#131722, text_size=sz)
    table.cell(combinedT, 2, 3,  "Profit Factor", text_color=#787B86, bgcolor=#1E222D, text_size=sz)
    table.cell(combinedT, 3, 3,  na(pf)?"–":str.tostring(pf,"#.##"),         text_color=pfC,    bgcolor=#131722, text_size=sz)
    table.cell(combinedT, 2, 4,  "Net P&L",       text_color=#787B86, bgcolor=#1E222D, text_size=sz)
    table.cell(combinedT, 3, 4,  str.tostring(strategy.netprofit,"#.##"),    text_color=strategy.netprofit>=0?#00E676:#FF5252, bgcolor=#131722, text_size=sz)
    table.cell(combinedT, 2, 5,  "Max DD",        text_color=#787B86, bgcolor=#1E222D, text_size=sz)
    table.cell(combinedT, 3, 5,  str.tostring(strategy.max_drawdown,"#.##"), text_color=#FF5252, bgcolor=#131722, text_size=sz)
    table.cell(combinedT, 2, 6,  "Avg Win",       text_color=#787B86, bgcolor=#1E222D, text_size=sz)
    table.cell(combinedT, 3, 6,  str.tostring(avgW,"#.##"),                  text_color=#00E676, bgcolor=#131722, text_size=sz)
    table.cell(combinedT, 2, 7,  "Avg Loss",      text_color=#787B86, bgcolor=#1E222D, text_size=sz)
    table.cell(combinedT, 3, 7,  str.tostring(avgL,"#.##"),                  text_color=#FF5252, bgcolor=#131722, text_size=sz)
    table.cell(combinedT, 2, 8,  "Expectancy",    text_color=#787B86, bgcolor=#1E222D, text_size=sz)
    table.cell(combinedT, 3, 8,  str.tostring(exp_,"#.##"),                  text_color=exp_>=0?#00E676:#FF5252, bgcolor=#131722, text_size=sz)
    table.cell(combinedT, 2, 9,  "Open P&L",      text_color=#787B86, bgcolor=#1E222D, text_size=sz)
    table.cell(combinedT, 3, 9,  str.tostring(strategy.openprofit,"#.##"),   text_color=strategy.openprofit>=0?#00E676:#FF5252, bgcolor=#131722, text_size=sz)
    table.cell(combinedT, 2, 10, "EMA Stack",     text_color=#787B86, bgcolor=#1E222D, text_size=sz)
    table.cell(combinedT, 3, 10, emaUptrendStrict?"20>50>200":emaDowntrendStrict?"20<50<200":"MIXED", text_color=emaUptrend?#00E676:emaDowntrend?#FF5252:#FFC107, bgcolor=#131722, text_size=sz)
    table.cell(combinedT, 2, 11, "HTF Gate",      text_color=#787B86, bgcolor=#1E222D, text_size=sz)
    table.cell(combinedT, 3, 11, useHtfGate?"15m ON":"OFF",                  text_color=useHtfGate?#00E676:#787B86, bgcolor=#131722, text_size=sz)
    table.cell(combinedT, 2, 12, "ST Mult",       text_color=#787B86, bgcolor=#1E222D, text_size=sz)
    table.cell(combinedT, 3, 12, str.tostring(stMult,"#.0")+" / "+str.tostring(stMultH,"#.0"),  text_color=#D1D4DC, bgcolor=#131722, text_size=sz)
    table.cell(combinedT, 2, 13, "Risk/Trade",    text_color=#787B86, bgcolor=#1E222D, text_size=sz)
    table.cell(combinedT, 3, 13, str.tostring(riskPct,"#.1")+"%",            text_color=#FFC107, bgcolor=#131722, text_size=sz)

// ============================================================================
// SECTION 21 — TRADE LOG (bottom_right)
// ============================================================================

var table logT = table.new(position.bottom_right, 6, 11,
    bgcolor=color.new(#131722,10), border_color=color.new(#2A2E39,0), border_width=1,
    frame_color=color.new(#2A2E39,0), frame_width=1)

if showTradeLog and barstate.islast
    sz = size.tiny
    hC = #2A2E39
    hT = #D1D4DC
    table.cell(logT, 0, 0, "#",      text_color=hT, bgcolor=hC, text_size=sz)
    table.cell(logT, 1, 0, "Dir",    text_color=hT, bgcolor=hC, text_size=sz)
    table.cell(logT, 2, 0, "Entry",  text_color=hT, bgcolor=hC, text_size=sz)
    table.cell(logT, 3, 0, "Exit",   text_color=hT, bgcolor=hC, text_size=sz)
    table.cell(logT, 4, 0, "P&L $",  text_color=hT, bgcolor=hC, text_size=sz)
    table.cell(logT, 5, 0, "Result", text_color=hT, bgcolor=hC, text_size=sz)
    ct   = strategy.closedtrades
    show = math.min(ct, 10)
    for r = 1 to 10
        if r <= show
            idx  = ct - r
            dir  = strategy.closedtrades.size(idx) > 0 ? "L" : "S"
            ep_  = strategy.closedtrades.entry_price(idx)
            ex_  = strategy.closedtrades.exit_price(idx)
            pnl_ = strategy.closedtrades.profit(idx)
            isW  = pnl_ > 0
            bg   = isW ? color.new(#1B3A2A,0) : color.new(#3A1B1B,0)
            tc   = isW ? #00E676 : #FF5252
            table.cell(logT, 0, r, str.tostring(idx+1),      text_color=#787B86, bgcolor=bg, text_size=sz)
            table.cell(logT, 1, r, dir,                       text_color=dir=="L"?#00E676:#FF5252, bgcolor=bg, text_size=sz)
            table.cell(logT, 2, r, str.tostring(ep_,"#.##"),  text_color=#D1D4DC, bgcolor=bg, text_size=sz)
            table.cell(logT, 3, r, str.tostring(ex_,"#.##"),  text_color=#D1D4DC, bgcolor=bg, text_size=sz)
            table.cell(logT, 4, r, str.tostring(pnl_,"#.##"), text_color=tc,      bgcolor=bg, text_size=sz)
            table.cell(logT, 5, r, isW?"WIN":"LOSS",          text_color=tc,      bgcolor=bg, text_size=sz)
        else
            for c = 0 to 5
                table.cell(logT, c, r, "–", text_color=#2A2E39, bgcolor=#131722, text_size=sz)

// ============================================================================
// SECTION 22 — ALERTS
// ============================================================================

alertcondition(longCond,  "BUY  — Long Entry",  "URA v14 — BUY: EMA stack + ST flip + HTF + ADX confirmed")
alertcondition(shortCond, "SELL — Short Entry", "URA v14 — SELL: EMA stack + ST flip + HTF + ADX confirmed")
alertcondition(strategy.position_size == 0 and strategy.position_size[1] != 0, "Trade Closed", "URA v14 — trade closed")

// ============================================================================
// END — Add URA_Indicators.pine to a separate pane for RSI + ADX sub-pane
// ============================================================================
