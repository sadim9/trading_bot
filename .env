# ─────────────────────────────────────────────────────────────
#  Trading Bot — Environment Variables
#  Copy this file to .env and fill in ALL values before running.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
APP_NAME=TradingBot API
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | production
DEBUG=false

# ── Security ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=any_long_random_string_for_local_dev

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:8501

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=trading
POSTGRES_PASSWORD=localpass
POSTGRES_DB=trading_bot
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://trading:localpass@db:5432/trading_bot

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# ── Bot Worker ────────────────────────────────────────────────
BOT_POLL_INTERVAL_SECONDS=60
BOT_DEFAULT_SOURCE=yfinance
# Set to admin user UUID after first registration
BOT_WORKER_USER_ID=
# Auto-create paper trades from strong signals (true | false)
BOT_AUTO_PAPER_TRADE=false

# ── Twelve Data (optional — for commodity price feeds) ────────
TWELVEDATA_API_KEY=

# ── Discord (optional) ────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ── SSL / Domain (used by Nginx and Let's Encrypt) ────────────
DOMAIN=yourdomain.com
CERTBOT_EMAIL=your@email.com
