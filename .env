# ─────────────────────────────────────────────────────────────
#  Trading Bot — Environment Variables
#  Copy this file to .env and fill in ALL values before running.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
APP_NAME=TradingBot API
APP_VERSION=1.0.0
ENVIRONMENT=production          # development | production
DEBUG=false

# ── Security ──────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=d6e728f0bc0649859c2d638a96556b9541e56ad5f778cd54c6b25a651c3f2e2bc02937ee79d97f2a8c895c8f50b3037e882e351fffbc67e02eee80ca59c185f2

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://theapextraders.com,https://www.theapextraders.com

# ── Trusted Hosts ──────────────────────────────────────────
# Comma-separated. Must include your domain in production.
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=trading
POSTGRES_PASSWORD=Tr1n1d4d_1981_2014_3111
POSTGRES_DB=trading_bot
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://trading:Tr1n1d4d_1981_2014_3111@db:5432/trading_bot

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# ── Bot Worker ────────────────────────────────────────────────
BOT_POLL_INTERVAL_SECONDS=60
BOT_DEFAULT_SOURCE=yfinance
# Set to admin user UUID after first registration
BOT_WORKER_USER_ID=
# Auto-create paper trades from strong signals (true | false)
BOT_AUTO_PAPER_TRADE=false

# ── Twelve Data (optional — for commodity price feeds) ────────
TWELVEDATA_API_KEY=

# ── Discord (optional) ────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ── SSL / Domain (used by Nginx and Let's Encrypt) ────────────
DOMAIN=theapextraders.com
CERTBOT_EMAIL=sadim9dev@gmail.com
ALLOWED_HOSTS=localhost,127.0.0.1,api,theapextraders.com,www.theapextraders.com
